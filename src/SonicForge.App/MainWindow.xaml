<Window x:Class="SonicForge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SonicForge MP3 Studio 1.0.0" Width="1380" Height="900" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#04080D" Foreground="White">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="EqBar1" Storyboard.TargetProperty="Height" From="22" To="82" Duration="0:0:0.52" AutoReverse="True" BeginTime="0:0:0.00" />
                    <DoubleAnimation Storyboard.TargetName="EqBar2" Storyboard.TargetProperty="Height" From="88" To="30" Duration="0:0:0.67" AutoReverse="True" BeginTime="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="EqBar3" Storyboard.TargetProperty="Height" From="36" To="96" Duration="0:0:0.43" AutoReverse="True" BeginTime="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="EqBar4" Storyboard.TargetProperty="Height" From="92" To="28" Duration="0:0:0.61" AutoReverse="True" BeginTime="0:0:0.05" />
                    <DoubleAnimation Storyboard.TargetName="EqBar5" Storyboard.TargetProperty="Height" From="30" To="78" Duration="0:0:0.48" AutoReverse="True" BeginTime="0:0:0.22" />
                    <DoubleAnimation Storyboard.TargetName="EqBar6" Storyboard.TargetProperty="Height" From="98" To="42" Duration="0:0:0.73" AutoReverse="True" BeginTime="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#18E5FF" />
        <SolidColorBrush x:Key="Pink" Color="#FF3ED1" />
        <SolidColorBrush x:Key="Gold" Color="#FFB33C" />
        <SolidColorBrush x:Key="Mint" Color="#59F2B5" />
        <SolidColorBrush x:Key="Panel" Color="#09151F" />
        <SolidColorBrush x:Key="Panel2" Color="#0D202C" />
        <LinearGradientBrush x:Key="Wood" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2A100B" Offset="0" /><GradientStop Color="#6B2714" Offset="0.18" />
            <GradientStop Color="#38140E" Offset="0.5" /><GradientStop Color="#7C2F18" Offset="0.82" /><GradientStop Color="#260E0A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Chrome" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF1D2" Offset="0" /><GradientStop Color="#AD6E31" Offset="0.22" />
            <GradientStop Color="#FFE0A0" Offset="0.48" /><GradientStop Color="#6E3A18" Offset="0.76" /><GradientStop Color="#F8C169" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Hero" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#111E32" Offset="0" /><GradientStop Color="#082735" Offset="0.5" /><GradientStop Color="#241127" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CyanGlow" Color="#18E5FF" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
        <DropShadowEffect x:Key="PinkGlow" Color="#FF3ED1" BlurRadius="18" ShadowDepth="0" Opacity="0.75" />
        <DropShadowEffect x:Key="GoldGlow" Color="#FFAE32" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />

        <Style x:Key="Nav" TargetType="Button">
            <Setter Property="Foreground" Value="#D3E6F2" /><Setter Property="Background" Value="#0B1A25" />
            <Setter Property="Padding" Value="15,11" /><Setter Property="Margin" Value="0,3" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#173748" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#103041" /><Setter TargetName="B" Property="BorderBrush" Value="#18E5FF" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#07131B" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#031015" /><Setter Property="Background" Value="{StaticResource Cyan}" />
            <Setter Property="Padding" Value="17,11" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#70F1FF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#163247" /></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#102633" /><Setter Property="Foreground" Value="#9DC6D8" /><Setter Property="Padding" Value="12,10" /><Setter Property="BorderBrush" Value="#234252" /><Setter Property="BorderThickness" Value="0,0,1,1" /></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="#09151F" /><Setter Property="Foreground" Value="#EAF8FF" /><Setter Property="MinHeight" Value="40" /><Setter Property="BorderBrush" Value="#142B38" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#102C3A" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#154356" /></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,7" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Resources>

    <Border Margin="10" Background="{StaticResource Wood}" CornerRadius="28" BorderBrush="{StaticResource Chrome}" BorderThickness="4">
        <Border Margin="7" Background="#050B11" CornerRadius="23" BorderBrush="#542716" BorderThickness="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="245" /><RowDefinition Height="*" /><RowDefinition Height="156" /></Grid.RowDefinitions>

                <!-- Hoher Jukebox-Kopf -->
                <Grid Grid.Row="0" ClipToBounds="True">
                    <Border Background="{StaticResource Wood}" CornerRadius="18,18,0,0" />
                    <Ellipse Width="1020" Height="470" Margin="0,15,0,-250" VerticalAlignment="Top" Stroke="{StaticResource Chrome}" StrokeThickness="15" Fill="#080D14" />
                    <Ellipse Width="920" Height="420" Margin="0,25,0,-225" VerticalAlignment="Top" Stroke="#FF9F32" StrokeThickness="18" Fill="Transparent" Effect="{StaticResource GoldGlow}" />
                    <Ellipse Width="835" Height="382" Margin="0,36,0,-205" VerticalAlignment="Top" Stroke="#FF3ED1" StrokeThickness="17" Fill="Transparent" Effect="{StaticResource PinkGlow}" />
                    <Ellipse Width="752" Height="345" Margin="0,48,0,-185" VerticalAlignment="Top" Stroke="#18E5FF" StrokeThickness="14" Fill="Transparent" Effect="{StaticResource CyanGlow}" />

                    <Grid Width="625" Height="194" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <Border Background="#071018" CornerRadius="22" BorderBrush="#B66B31" BorderThickness="3" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Ellipse Width="112" Height="112" Fill="#111" Stroke="#662755" StrokeThickness="3" />
                                <Ellipse Width="72" Height="72" Fill="#25112A" Stroke="#FF3ED1" StrokeThickness="2" Effect="{StaticResource PinkGlow}" />
                                <Ellipse Width="22" Height="22" Fill="#FFB33C" />
                                <Path Data="M 32,108 C 45,72 55,96 68,56 C 82,22 96,85 110,42 C 122,11 135,80 147,35" Stroke="#18E5FF" StrokeThickness="5" Fill="Transparent" Stretch="Fill" Margin="18,39,18,39" Effect="{StaticResource CyanGlow}" />
                            </Grid>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="SONICFORGE" FontSize="35" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#18E5FF" /><GradientStop Color="#FFFFFF" Offset="0.48" /><GradientStop Color="#FFB33C" Offset="1" /></LinearGradientBrush></TextBlock.Foreground>
                                    <TextBlock.Effect><DropShadowEffect Color="#18E5FF" BlurRadius="15" ShadowDepth="0" /></TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="M P 3   S T U D I O" Foreground="#83EEFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8" />
                                <Border Height="1" Background="#275A6E" Margin="18,0" />
                                <TextBlock Text="DEINE MUSIK. DEINE DATEIEN. DEINE FREIHEIT." Foreground="#7CB8C9" FontSize="9" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle x:Name="EqBar1" Width="7" Height="38" Fill="#18E5FF" Margin="3" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3" />
                                    <Rectangle x:Name="EqBar2" Width="7" Height="68" Fill="#18E5FF" Margin="3" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3" />
                                    <Rectangle x:Name="EqBar3" Width="7" Height="46" Fill="#FF3ED1" Margin="3" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3" />
                                    <Rectangle x:Name="EqBar4" Width="7" Height="82" Fill="#FF3ED1" Margin="3" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3" />
                                    <Rectangle x:Name="EqBar5" Width="7" Height="57" Fill="#FFB33C" Margin="3" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3" />
                                    <Rectangle x:Name="EqBar6" Width="7" Height="93" Fill="#FFB33C" Margin="3" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                    <TextBlock Text="♪  MUSIC LIVES HERE  ♪" Foreground="#68ECFF" FontStyle="Italic" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="55,0,0,28" Effect="{StaticResource CyanGlow}" />
                    <TextBlock Text="♪  LET THE MUSIC PLAY  ♪" Foreground="#FF88DF" FontStyle="Italic" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,55,28" Effect="{StaticResource PinkGlow}" />
                </Grid>

                <!-- Hauptbereich -->
                <Grid Grid.Row="1" Margin="18,10,18,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#06111A" CornerRadius="18" BorderBrush="#713119" BorderThickness="2" Padding="14">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,14"><Border Width="37" Height="37" CornerRadius="11" Background="{StaticResource Cyan}" Effect="{StaticResource CyanGlow}"><TextBlock Text="S" FontSize="22" FontWeight="Black" Foreground="#031016" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="10,1,0,0"><TextBlock Text="SONICFORGE" Foreground="{StaticResource Cyan}" FontWeight="Bold" /><TextBlock Text="NEON JUKEBOX" Foreground="#668596" FontSize="9" /></StackPanel></StackPanel>
                            <StackPanel Grid.Row="1">
                                <Button x:Name="HomeNavButton" Style="{StaticResource Nav}" Background="#103648" BorderBrush="#18E5FF" Content="⌂   Startseite" Click="HomeNav_Click" />
                                <Button x:Name="LibraryNavButton" Style="{StaticResource Nav}" Content="♫   Bibliothek" Click="LibraryNav_Click" />
                                <Button Style="{StaticResource Nav}" Content="●   Aufnehmen" />
                                <Button Style="{StaticResource Nav}" Content="✦   Audio-Werkstatt" />
                                <Button Style="{StaticResource Nav}" Content="◉   CD-Import" />
                                <Button Style="{StaticResource Nav}" Content="⌁   Radio und Podcasts" Click="RadioPodcastDirect_Click" />
                                <Button Style="{StaticResource Nav}" Content="◍   Spotify" x:Name="SpotifyNavButton" PreviewMouseLeftButtonDown="SpotifyNav_PreviewMouseLeftButtonDown" />
                                <Button Style="{StaticResource Nav}" Content="♡   Wunschliste"  Click="Wishlist_Click" />
                                <Button Style="{StaticResource Nav}" Content="⚙   Einstellungen" Click="Settings_Click" />
                                <Button x:Name="UpdateInfoNavButton" Style="{StaticResource Nav}" Content="Updates und Version" Click="UpdateInfo_Click" />
                            </StackPanel>
                            <Border Grid.Row="2" Background="#0D2230" CornerRadius="12" Padding="11" BorderBrush="#245064" BorderThickness="1"><StackPanel><Button Content="Open Source" Click="OpenSource_Click" Style="{StaticResource DarkButton}" Padding="10,7" FontSize="11" /><TextBlock Text="GPL-3.0-or-later" Foreground="#5CE8B0" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0" /></StackPanel></Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="15,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="Import_Click" Margin="0,0,7,0" Style="{StaticResource Primary}" Content="♫  Dateien importieren" />
                            <Button Grid.Column="1" Click="ImportFolder_Click" Margin="7,0" Style="{StaticResource DarkButton}" Content="▣  Ordner importieren" />
                            <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource DarkButton}" Content="◉  Audio-CD einlesen" />
                        </Grid>
                        <Border Grid.Row="1" Background="#081722" CornerRadius="13" BorderBrush="#275267" BorderThickness="1" Padding="12" Margin="0,13,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="{StaticResource Cyan}" FontSize="21" Margin="2,0,11,0" /><TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalContentAlignment="Center" ToolTip="Musikbibliothek durchsuchen" /><Border Grid.Column="2" Background="#102A38" CornerRadius="9" Padding="13,5"><TextBlock Text="LOKALE BIBLIOTHEK" Foreground="#78DBEA" FontSize="9" FontWeight="Bold" /></Border></Grid></Border>
                        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="14" BorderBrush="#1C3D4C" BorderThickness="1" Padding="7">
                            <DataGrid x:Name="TracksGrid" ItemsSource="{Binding TracksView}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TracksGrid_SelectionChanged" MouseDoubleClick="TracksGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TITEL" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="INTERPRET" Binding="{Binding Artist}" Width="180" />
                                    <DataGridTextColumn Header="ALBUM" Binding="{Binding Album}" Width="180" />
                                    <DataGridTextColumn Header="DAUER" Binding="{Binding DurationText}" Width="75" />
                                    <DataGridTextColumn Header="QUALITÄT" Binding="{Binding BitrateText}" Width="95" />
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="125" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <DockPanel Grid.Row="3" Margin="4,10,4,0"><TextBlock x:Name="StatusText" Text="Bereit. Audio-Dateien können importiert werden." Foreground="{StaticResource Mint}" FontSize="10" /><TextBlock Text="Version 1.0.0 | GNU GPLv3" HorizontalAlignment="Right" Foreground="#587785" FontSize="10" /></DockPanel>
                    </Grid>
                </Grid>

                <!-- Fester Player -->
                <Border Grid.Row="2" Margin="18,0,18,12" Background="#06121B" CornerRadius="17" BorderBrush="#753219" BorderThickness="2" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="350" /><ColumnDefinition Width="*" /><ColumnDefinition Width="245" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="92" Height="92" CornerRadius="15" Background="{StaticResource Hero}" BorderBrush="#FF3ED1" BorderThickness="1">
                                <Grid>
                                    <Ellipse Width="38" Height="38" Fill="#101015" Stroke="#FF3ED1" />
                                    <Ellipse Width="10" Height="10" Fill="#FFB33C" />
                                    <Image x:Name="CurrentCoverImage" Width="84" Height="84" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="12,5,0,0" MaxWidth="225">
                                <TextBlock x:Name="CurrentTitleText" Text="Noch kein Titel gewählt" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CurrentAlbumText" Text="" Foreground="#A9C6D3" FontSize="10" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PlayerStatusText" Text="SonicForge Player bereit" Foreground="#7291A2" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="|◀" Click="Previous_Click" Style="{StaticResource Nav}" Padding="12,7" ToolTip="Vorheriger Titel" />
                                <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPause_Click" Style="{StaticResource Primary}" Padding="18,10" Margin="8,0" ToolTip="Wiedergabe oder Pause" />
                                <Button Content="■" Click="Stop_Click" Style="{StaticResource Nav}" Padding="12,7" ToolTip="Stopp" />
                                <Button Content="▶|" Click="Next_Click" Style="{StaticResource Nav}" Padding="12,7" Margin="8,0,0,0" ToolTip="Nächster Titel" />
                            </StackPanel>
                            <Grid Width="470" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /><ColumnDefinition Width="45" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="PositionText" Text="00:00" Foreground="#7CB8C9" FontSize="9" VerticalAlignment="Center" />
                                <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" ValueChanged="ProgressSlider_ValueChanged" Margin="7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" Foreground="#7CB8C9" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="▮)))" Foreground="#87C9D8" FontSize="14" Margin="0,0,10,0" />
                            <Slider x:Name="VolumeSlider" Width="155" Minimum="0" Maximum="1" Value="0.75" ValueChanged="VolumeSlider_ValueChanged" ToolTip="Lautstärke" />
                        </StackPanel>
                    </Grid>
                </Border>
                    <Button Content="Studioübersicht" Click="OpenStudioOverview_Click" ToolTip="Oeffnet die zentrale Auswahl fuer CD-Import, Schallplatte, Streaming, Instrumente und Zusatzbereiche." HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="999" Margin="0,18,22,0" Padding="15,9" MinWidth="145" Background="#0E5368" Foreground="White" BorderBrush="#20DFF2" BorderThickness="1" /></Grid>
        </Border>
    </Border>
</Window>


