<Window x:Class="SonicForge.App.CdImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SonicForge CD-Importstudio 0.9.3" Width="980" Height="760" MinWidth="880" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="#061019" Foreground="White">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="5"/><Setter Property="Background" Value="#15384A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2D667C"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#102532"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2D667C"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#081721"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#0B1D28"/><Setter Property="AlternatingRowBackground" Value="#0E2430"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#204252"/></Style>
   <Style x:Key="SonicForgeColumnHeaderStyle" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#123247"/>
   <Setter Property="Foreground" Value="#F4FBFF"/>
   <Setter Property="BorderBrush" Value="#2B6079"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="8,6"/>
  </Style>
  <Style x:Key="SonicForgeImportCheckBoxStyle" TargetType="CheckBox">
   <Setter Property="Foreground" Value="#F4FBFF"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="8,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="SONICFORGE CD-IMPORTSTUDIO 0.9.3" Foreground="#18E5FF" FontWeight="Bold" FontSize="12"/>
   <TextBlock Text="Audio-CD Metadaten vorbereiten" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,3"/>
   <TextBlock Text="CD-Text wird automatisch versucht, alle Angaben bleiben bearbeitbar" Foreground="#7898A7"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,18,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="CD-LAUFWERK" Foreground="#82B8C9" FontSize="10"/><ComboBox x:Name="DriveBox" MinWidth="260" DisplayMemberPath="Name" Padding="10,7"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Disc einlesen" Click="ReadDisc_Click"/><Button Content="Disc-ID schnell suchen" Click="MusicBrainz_Click" Background="#18E5FF" Foreground="#031015" FontWeight="Bold"/></StackPanel>
   <Button Grid.Column="2" Content="Auswerfen" Click="Eject_Click" VerticalAlignment="Bottom"/>
  </Grid>
  <Border Grid.Row="2" Background="#091923" BorderBrush="#24485A" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="ALBUM" Foreground="#82B8C9" FontSize="10"/><TextBox x:Name="AlbumBox"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="ALBUM-INTERPRET" Foreground="#82B8C9" FontSize="10"/><TextBox x:Name="ArtistBox"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="JAHR" Foreground="#82B8C9" FontSize="10"/><TextBox x:Name="YearBox"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="3" Background="#091923" BorderBrush="#6B2C17" BorderThickness="2" CornerRadius="16" Padding="16">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><TextBlock x:Name="DiscSummaryText" Text="Noch keine Audio-CD eingelesen" Foreground="#62F0B2" FontWeight="Bold"/><TextBlock x:Name="DiscDurationText" DockPanel.Dock="Right" Foreground="#18E5FF" FontWeight="Bold"/></DockPanel>
    <DataGrid x:Name="TracksGrid" HeadersVisibility="Column" ColumnHeaderHeight="32" ColumnHeaderStyle="{StaticResource SonicForgeColumnHeaderStyle}" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" AlternationCount="2" SelectionMode="Extended">
     <DataGrid.Columns>
      <DataGridCheckBoxColumn Header="Import" Binding="{Binding IsSelected}" IsReadOnly="False" Width="70"/>
      <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="50"/>
      <DataGridTextColumn Header="Titelname (bearbeitbar)" Binding="{Binding DisplayTitle, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="*"/>
      <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" IsReadOnly="True" Width="90"/>
      <DataGridTextColumn Header="Quelle" Binding="{Binding MetadataSource}" IsReadOnly="True" Width="130"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Border>
  <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="ZIELORDNER" Foreground="#82B8C9" FontSize="10"/><TextBox x:Name="TargetFolderBox" Text="G:\SonicForge-CD-Importe"/><TextBlock x:Name="StatusText" Text="Bereit. Bitte Audio-CD einlegen und Disc einlesen." Foreground="#9FC3D2" Margin="0,7,0,0" TextWrapping="Wrap" MinHeight="30" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     <Grid x:Name="ImportProgressPanel" Margin="0,8,0,0" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><TextBlock Text="AKTUELLER TITEL" Foreground="#82B8C9" FontSize="10"/><TextBlock x:Name="TrackProgressText" DockPanel.Dock="Right" Text="0 %" Foreground="#18E5FF" FontWeight="Bold" Margin="14,0,0,0"/></DockPanel>
      <ProgressBar x:Name="TrackProgressBar" Grid.Row="1" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#18E5FF" Background="#102532" Margin="0,3,0,6"/>
      <DockPanel Grid.Row="2"><TextBlock Text="GESAMTFORTSCHRITT" Foreground="#82B8C9" FontSize="10"/><TextBlock x:Name="TotalProgressText" DockPanel.Dock="Right" Text="0 / 0" Foreground="#62F0B2" FontWeight="Bold" Margin="14,0,0,0"/></DockPanel>
      <ProgressBar x:Name="TotalProgressBar" Grid.Row="3" Height="12" Minimum="0" Maximum="1" Value="0" Foreground="#62F0B2" Background="#102532" Margin="0,3,0,0"/>
     </Grid></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Schließen" Click="Close_Click"/><CheckBox x:Name="CreateWavBox" Style="{StaticResource SonicForgeImportCheckBoxStyle}" MinWidth="118" Content="WAV archivieren" IsChecked="True" VerticalAlignment="Center" Margin="8"/><CheckBox x:Name="CreateMp3Box" Style="{StaticResource SonicForgeImportCheckBoxStyle}" MinWidth="130" Content="MP3 320 kbit/s" IsChecked="True" VerticalAlignment="Center" Margin="8"/><Button x:Name="CancelImportButton" Content="Abbrechen" Click="CancelImport_Click" IsEnabled="False" Visibility="Collapsed" Background="#6B2C17" Foreground="White" MinWidth="105"/><Button x:Name="ImportButton" MinWidth="170" Content="WAV + MP3 importieren" Click="Prepare_Click" Background="#18E5FF" Foreground="#031015" FontWeight="Bold"/></StackPanel>
  </Grid>
 </Grid>
</Window>
