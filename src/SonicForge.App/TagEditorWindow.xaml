<Window x:Class="SonicForge.App.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonicForge Tag- und Cover-Editor 0.7"
        Width="760" Height="590" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#071018" Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#102431"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#285268"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#173549"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A6178"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#8DB3C4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="TAG- UND COVER-EDITOR" Foreground="#18E5FF" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="Metadaten sicher in die Audiodatei schreiben" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,5"/>
            <TextBlock x:Name="FilePathText" Foreground="#688697" FontSize="10" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#0B1A24" CornerRadius="16" BorderBrush="#713119" BorderThickness="2" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#061019" CornerRadius="12" BorderBrush="#FF3ED1" BorderThickness="1" Padding="8">
                        <Grid>
                            <TextBlock x:Name="NoCoverText" Text="Kein Cover" Foreground="#6F8D9C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,13,0,0">
                        <Button Content="Cover auswählen" Click="SelectCover_Click" Margin="0,0,0,7"/>
                        <Button Content="Cover entfernen" Click="RemoveCover_Click" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="TITEL"/>
                    <TextBox x:Name="TitleBox"/>
                    <TextBlock Style="{StaticResource Label}" Text="INTERPRET"/>
                    <TextBox x:Name="ArtistBox"/>
                    <TextBlock Style="{StaticResource Label}" Text="ALBUM"/>
                    <TextBox x:Name="AlbumBox"/>
                    <TextBlock Style="{StaticResource Label}" Text="GENRE"/>
                    <TextBox x:Name="GenreBox"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="JAHR"/>
                            <TextBox x:Name="YearBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="TITELNUMMER"/>
                            <TextBox x:Name="TrackNumberBox"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="#12232D" CornerRadius="10" Padding="12" Margin="0,4,0,0">
                        <TextBlock Text="Vor dem Speichern legt SonicForge einmalig eine Sicherungskopie neben der Audiodatei an." Foreground="#6FE9B0" TextWrapping="Wrap" FontSize="11"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="#8DB3C4" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Abbrechen" Click="Cancel_Click"/>
                <Button Content="Änderungen speichern" Click="Save_Click" Background="#18E5FF" Foreground="#031015" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
