<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>Assets\SonicForgeStudio.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SonicForgeStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0-rc.3</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-rc.3-dev</InformationalVersion>
    <Authors>SonicForge Contributors</Authors>
    <Product>SonicForge MP3 Studio</Product>
    <Description>Open-source audio recording and CD-to-MP3 application for Windows.</Description>
    <VersionSuffix>rc.3</VersionSuffix>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SonicForge.Core\SonicForge.Core.csproj" />
    <ProjectReference Include="..\SonicForge.Library\SonicForge.Library.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MetaBrainz.MusicBrainz.DiscId" Version="5.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>
  <!-- WPF .NET 10.0.11: HTTP/HTTPS-Medienstreams wieder zulassen -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Net.DoNotApplyZoneCheckForDefaultCredentials" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LICENSE.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content>
    <Content Include="COPYRIGHT.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content>
    <Content Include="SOURCE-CODE.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content>
  </ItemGroup>
</Project>