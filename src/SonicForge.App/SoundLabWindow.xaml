<Window x:Class="SonicForge.App.SoundLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonicForge SoundLab 0.8.4" Width="1050" Height="680"
        MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="#061019" Foreground="White">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="5"/><Setter Property="Background" Value="#15384A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2D667C"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#102532"/>
            <Setter Property="BorderBrush" Value="#18E5FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="SelectionBorder" Background="#102532" BorderBrush="#2D667C" BorderThickness="1" CornerRadius="7"/>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid Margin="11,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" TextElement.Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="▼" Foreground="#18E5FF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#0B1F2B" BorderBrush="#18E5FF" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="220">
                                    <ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#18E5FF"/><Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0B1F2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="11,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="300"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SONICFORGE SOUNDLAB 0.8.4" Foreground="#18E5FF" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="10-Band Equalizer mit Headroom-Schutz" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,3"/>
                <TextBlock Text="Echtzeit-Klangbearbeitung, ohne die Musikdatei zu verändern" Foreground="#7898A7"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Equalizer" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="EnabledCheck" IsChecked="True" VerticalAlignment="Center" Checked="ControlChanged" Unchecked="ControlChanged"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KLANGPROFIL" Foreground="#82B8C9" FontSize="10"/>
                <ComboBox x:Name="PresetBox" SelectionChanged="PresetChanged">
                    <ComboBoxItem Content="Neutral"/><ComboBoxItem Content="SonicForge Jukebox"/><ComboBoxItem Content="Rock Live"/>
                    <ComboBoxItem Content="Bass ohne Dröhnen"/><ComboBoxItem Content="Sprache klar"/><ComboBoxItem Content="Nachtmodus"/><ComboBoxItem Content="Kopfhörer entspannt"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="A/B: Original" Click="Bypass_Click"/>
                <Button Content="Neutral zurücksetzen" Click="Reset_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <CheckBox x:Name="AutoHeadroomCheck" Content="Automatischer Headroom-Schutz" Foreground="White" IsChecked="True" Checked="ControlChanged" Unchecked="ControlChanged"/>
                <TextBlock x:Name="HeadroomText" Text="Headroom: 0,0 dB" Foreground="#62F0B2" FontWeight="Bold" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="#091923" CornerRadius="18" BorderBrush="#6B2C17" BorderThickness="2" Padding="20">
            <Grid x:Name="BandsGrid"/>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,17,0,0">
            <TextBlock Text="Änderungen wirken sofort. Einstellungen werden lokal gespeichert." Foreground="#6E8B99" VerticalAlignment="Center"/>
            <Button Content="SoundLab schließen" Click="Close_Click" DockPanel.Dock="Right" Background="#18E5FF" Foreground="#031015" FontWeight="Bold"/>
        </DockPanel>
    </Grid>
</Window>
