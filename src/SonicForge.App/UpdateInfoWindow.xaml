<Window x:Class="SonicForge.App.UpdateInfoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Versions- und Updateinformationen" Width="820" Height="720" MinWidth="760" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#07131B" Foreground="White">
 <Window.Resources>
  <Style x:Key="DisabledReadableButton" TargetType="Button">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="Padding" Value="16,9"/>
   <Setter Property="Foreground" Value="#E8F1F5"/>
   <Setter Property="Background" Value="#263B47"/>
   <Setter Property="BorderBrush" Value="#718995"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Opacity" Value="1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#315160"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1C303A"/></Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonBorder" Property="Background" Value="#25343D"/>
        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#627985"/>
        <Setter Property="Foreground" Value="#C7D5DC"/>
        <Setter Property="Opacity" Value="1"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="Padding" Value="16,9"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Background" Value="#243845"/>
     <Setter Property="Foreground" Value="#AFC2CC"/>
     <Setter Property="BorderBrush" Value="#526A76"/>
     <Setter Property="Opacity" Value="1"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Versions- und Updateinformationen" FontSize="28" FontWeight="Bold" Foreground="#18E5FF"/><TextBlock Grid.Row="1" Text="SonicForge Update-System" Margin="0,6,0,18" Foreground="#9DC6D8"/>
  <Border Grid.Row="2" Background="#0D202C" BorderBrush="#245064" BorderThickness="1" CornerRadius="14" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Installierte Version" FontWeight="Bold" Foreground="#59F2B5"/><TextBlock x:Name="VersionText" FontSize="20" Margin="0,4,0,12"/>
   <TextBlock Text="Updatequelle" FontWeight="Bold" Foreground="#59F2B5"/><TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <TextBlock Text="Pr&#252;fergebnis" FontWeight="Bold" Foreground="#59F2B5"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="17" Margin="0,4,0,12"/>
   <TextBlock x:Name="AvailableLabel" Text="Verf&#252;gbare Version" FontWeight="Bold" Foreground="#59F2B5" Visibility="Collapsed"/><TextBlock x:Name="AvailableVersionText" Margin="0,4,0,10" Visibility="Collapsed"/>
   <TextBlock x:Name="NotesLabel" Text="&#196;nderungen" FontWeight="Bold" Foreground="#59F2B5" Visibility="Collapsed"/><TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,5,0,14" Visibility="Collapsed"/>
   <TextBlock x:Name="PreparationLabel" Text="Vorbereitung" FontWeight="Bold" Foreground="#59F2B5" Visibility="Collapsed"/><TextBlock x:Name="PreparationText" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,5,0,14" Visibility="Collapsed"/>
   <Border Background="#102A38" BorderBrush="#18E5FF" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,8,0,0"><TextBlock Text="SonicForge pr&#252;ft verf&#252;gbare Aktualisierungen, validiert Updatepakete und bereitet diese sicher vor. Eine Installation erfolgt erst nach ausdr&#252;cklicher Best&#228;tigung." TextWrapping="Wrap" Foreground="#CDEBF2"/></Border>
  </StackPanel></ScrollViewer></Border>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,18,0,0"><Button x:Name="CheckButton" Content="Nach Updates suchen" MinWidth="135" Margin="0,0,10,0" Click="Check_Click" Background="#17465A" Foreground="White" BorderBrush="#18E5FF"/><Button x:Name="PrepareButton" Style="{StaticResource DisabledReadableButton}" Content="Paket pr&#252;fen und vorbereiten" MinWidth="155" Margin="0,0,10,0" Click="Prepare_Click" IsEnabled="False"/><Button x:Name="InstallTestButton" Style="{StaticResource DisabledReadableButton}" Content="Testinstallation" MinWidth="135" Margin="0,0,10,0" Click="InstallTest_Click" IsEnabled="False" Visibility="Collapsed" /><Button x:Name="RollbackTestButton" Style="{StaticResource DisabledReadableButton}" Content="Rueckfall testen" MinWidth="135" Margin="0,0,10,0" Click="RollbackTest_Click" IsEnabled="False" Visibility="Collapsed" /><Button Content="Schlie&#223;en" MinWidth="110" Click="Close_Click" Background="#C82745" Foreground="White" BorderBrush="#E34B67"/></StackPanel>
 </Grid>
</Window>

