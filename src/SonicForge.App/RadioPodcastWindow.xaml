<Window x:Class="SonicForge.App.RadioPodcastWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SonicForge Radio &amp; Podcasts" Width="1180" Height="780" MinWidth="980" MinHeight="680" Background="#030C13" Foreground="White" FontFamily="Segoe UI">
<Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#071822"/><SolidColorBrush x:Key="Panel2" Color="#0B2230"/><SolidColorBrush x:Key="Line" Color="#19475B"/><SolidColorBrush x:Key="Cyan" Color="#20DFF2"/><SolidColorBrush x:Key="Muted" Color="#8DB2C2"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#123244"/><Setter Property="BorderBrush" Value="#24586D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#19506A"/><Setter Property="BorderBrush" Value="#20DFF2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#F5F9FB"/><Setter Property="Foreground" Value="#07131B"/><Setter Property="CaretBrush" Value="#07131B"/><Setter Property="BorderBrush" Value="#46BCD0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/><Setter Property="SelectionBrush" Value="#16AFC4"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#06141D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#19475B"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#163A49"/><Setter Property="RowBackground" Value="#071923"/><Setter Property="AlternatingRowBackground" Value="#0A202C"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="30"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#11384A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#20DFF2"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,3"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#087E93"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#06141D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#19475B"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="White"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0C7185"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#12384A"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" Margin="0,0,0,2"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9FC6D4"/><Setter Property="Background" Value="#081923"/><Setter Property="BorderBrush" Value="#19475B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#11384A"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#0E5368"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#20DFF2"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="SONICFORGE" Foreground="{StaticResource Cyan}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Radio &amp; Podcasts" FontSize="30" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="Sender entdecken, live hören und direkt als MP3 aufnehmen" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Column="1" Background="#0B2734" BorderBrush="#1D5267" BorderThickness="1" CornerRadius="14" Padding="16,10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#45E5A3" Margin="0,0,9,0"/><TextBlock Text="RADIO BEREIT" Foreground="#8FF2C5" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Border>
    </Grid>
    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
        <TabItem Header="Internetradio"><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="SENDER ENTDECKEN" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="12"/>
                <Grid Grid.Row="1" Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="Sendername oder Musikrichtung"/><Button Grid.Column="1" Content="Deutschland durchsuchen" Click="SearchGermany_Click" Margin="10,0,0,0" ToolTip="Sucht nach Internetradiosendern aus Deutschland."/></Grid>
                <DataGrid x:Name="SearchResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="SearchResults_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Sender" Binding="{Binding Name}" Width="2.1*"/><DataGridTextColumn Header="Bundesland" Binding="{Binding State}" Width="1.15*"/><DataGridTextColumn Header="Genre" Binding="{Binding Tags}" Width="2*"/><DataGridTextColumn Header="Codec" Binding="{Binding Codec}" Width="70"/></DataGrid.Columns></DataGrid>
            </Grid></Border>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="AKTUELLER SENDER" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="12"/><TextBlock Text="Sendername" Foreground="{StaticResource Muted}" Margin="0,12,0,5"/><TextBox x:Name="StationNameBox"/><TextBlock Text="Direkte Stream-Adresse" Foreground="{StaticResource Muted}" Margin="0,11,0,5"/><TextBox x:Name="StationUrlBox"/><Button Content="★ Sender speichern" Click="AddStation_Click" Margin="0,12,0,0" Background="#116A76" ToolTip="Speichert den eingetragenen Sender in Meine Sender."/></StackPanel></Border>
                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="MEINE SENDER" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="12"/><TextBlock Text="Doppelklick zum Abspielen" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="11"/></Grid><ListBox x:Name="StationList" Grid.Row="1" DisplayMemberPath="Name" MouseDoubleClick="StationList_DoubleClick" Margin="0,10,0,0"/></Grid></Border>
            </Grid>
        </Grid></TabItem>
        <TabItem Header="Podcasts"><Border Margin="0,14,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FeedUrlBox" ToolTip="Podcast-RSS-Adresse"/><Button Grid.Column="1" Content="RSS laden" Click="LoadFeed_Click" Margin="10,0,0,0" ToolTip="Laedt die Folgen des eingetragenen Podcast-RSS-Feeds."/></Grid><DataGrid x:Name="EpisodeGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="EpisodeGrid_DoubleClick" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Datum" Binding="{Binding Date}" Width="180"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
        <Border Background="#0B2533" BorderBrush="#20DFF2" BorderThickness="1" CornerRadius="14" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="RecordingText" Text="Aufnahme bereit" Foreground="#FFCE66" FontWeight="Bold"/><TextBlock x:Name="RecordingPathText" Text="Speicherort: Musik\SonicForge\Radioaufnahmen" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="RecordButton" Grid.Column="1" Content="● Aufnahme" Click="Record_Click" Margin="12,0,6,0" Background="#A51F3B" ToolTip="Startet die Aufnahme des aktuell abgespielten Radiosenders."/><Button x:Name="StopRecordButton" Grid.Column="2" Content="■ Stoppen" Click="StopRecord_Click" IsEnabled="False" ToolTip="Beendet und speichert die laufende Radioaufnahme."/></Grid></Border>
        <Border Grid.Column="2" Background="#0B2533" BorderBrush="#245064" BorderThickness="1" CornerRadius="14" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NowPlayingText" Text="Bereit" Foreground="#61F0B4" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Doppelklick startet einen Sender oder eine Podcast-Folge." Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Ⅱ Pause" Click="Pause_Click" Margin="8,0,4,0" ToolTip="Pausiert die aktuelle Wiedergabe."/><Button Content="▶ Weiter" Click="Resume_Click" Margin="4,0" ToolTip="Setzt eine pausierte Wiedergabe fort."/><Button Content="■ Stopp" Click="Stop_Click" Margin="4,0" ToolTip="Beendet die aktuelle Wiedergabe."/><Button Content="Entfernen" Click="Remove_Click" Margin="4,0,0,0" ToolTip="Entfernt den ausgewaehlten gespeicherten Sender."/></StackPanel></Grid></Border>
    </Grid>
</Grid></Window>
