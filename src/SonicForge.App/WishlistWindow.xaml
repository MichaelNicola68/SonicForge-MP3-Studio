<Window x:Class="SonicForge.App.WishlistWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SonicForge Wunschliste" Width="1060" Height="700" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#030C13" Foreground="White" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#123244"/><Setter Property="BorderBrush" Value="#24586D"/><Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#F5F9FB"/><Setter Property="Foreground" Value="#07131B"/><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#46BCD0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#F5F9FB"/><Setter Property="Foreground" Value="#07131B"/><Setter Property="Padding" Value="7,5"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#06141D"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#071923"/><Setter Property="AlternatingRowBackground" Value="#0A202C"/><Setter Property="BorderBrush" Value="#19475B"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#163A49"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#11384A"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="9,7"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,3"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#087E93"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SONICFORGE" Foreground="#20DFF2" FontWeight="Bold"/><TextBlock Text="Meine Wunschliste" FontSize="29" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="Musik merken, in Spotify suchen und mit der eigenen Bibliothek abgleichen." Foreground="#91B8C8" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Spotify öffnen" Click="OpenSpotify_Click" Background="#146B48" VerticalAlignment="Center"/></Grid>
  <Border Grid.Row="1" Background="#081C27" BorderBrush="#1B4B5E" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,18,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="Interpret" Foreground="#A5C5D1"/><TextBox x:Name="ArtistBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Titel" Foreground="#A5C5D1"/><TextBox x:Name="TitleBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Album" Foreground="#A5C5D1"/><TextBox x:Name="AlbumBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Status" Foreground="#A5C5D1"/><ComboBox x:Name="StatusBox" Margin="0,5,0,0" SelectedIndex="0"><ComboBoxItem Content="Gewünscht"/><ComboBoxItem Content="Gefunden"/><ComboBoxItem Content="Aufgenommen"/><ComboBoxItem Content="In Bibliothek"/></ComboBox></StackPanel>
   <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,8,0"><TextBlock Text="Notiz oder Spotify-Link" Foreground="#A5C5D1"/><TextBox x:Name="NoteBox" Margin="0,5,0,0"/></StackPanel><Button Grid.Row="1" Grid.Column="3" Content="+ Hinzufügen" Click="Add_Click" Margin="8,30,0,0" Background="#0F7180"/>
  </Grid></Border>
  <DataGrid x:Name="WishlistGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Interpret" Binding="{Binding Artist}" Width="1.3*"/><DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="1.5*"/><DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="1.2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Notiz / Link" Binding="{Binding Note}" Width="1.5*"/><DataGridTextColumn Header="Hinzugefügt" Binding="{Binding AddedText}" Width="120"/></DataGrid.Columns></DataGrid>
  <Border Grid.Row="3" Background="#071923" BorderBrush="#173D4D" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Wunschliste bereit." Foreground="#73EFB8" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="In Spotify suchen" Click="SearchSpotify_Click" Margin="5,0" Background="#146B48"/><Button Content="Status weiter" Click="AdvanceStatus_Click" Margin="5,0"/><Button Content="Entfernen" Click="Remove_Click" Margin="5,0,0,0"/></StackPanel></Grid></Border>
 </Grid>
</Window>
