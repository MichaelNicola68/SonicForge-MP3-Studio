<Window x:Class="SonicForge.App.RecordingStudioWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SonicForge Aufnahmestudio 0.9.5 Phase 1" Width="1240" Height="820" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#050B11" Foreground="White" WindowState="Normal" SizeToContent="Manual">
 <Window.Resources>
  <SolidColorBrush x:Key="Cyan" Color="#18E5FF" /><SolidColorBrush x:Key="Pink" Color="#FF3ED1" />
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10" /><Setter Property="Margin" Value="4" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Background" Value="#153247" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#275267" /></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,5" /><Setter Property="Background" Value="#102633" /><Setter Property="Foreground" Value="#071219" /></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,5" /><Setter Property="Background" Value="#102633" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#275267" /></Style>
 </Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SONICFORGE AUFNAHMESTUDIO" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="26" /><TextBlock Text="Mikrofon, Line-In oder Systemton verlustfrei als WAV aufnehmen" Foreground="#8FB6C8" Margin="0,4,0,16" /></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Aufnahmequelle" /><ComboBox x:Name="DeviceBox" MinWidth="510" /></StackPanel>
   <Button Grid.Column="1" Content="Geräte neu laden" Click="ReloadDevices_Click" VerticalAlignment="Bottom" ToolTip="Liest alle aktuell verfuegbaren Mikrofon-, Line-In- und Systemtonquellen neu ein." />
  </Grid>
  <Border Grid.Row="2" Background="#09151F" BorderBrush="#1C3D4C" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,16">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock x:Name="TimeText" Text="00:00:00" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Cyan}" />
    <Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><StackPanel Tag="SonicForgeMeterUnit" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Links" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" /><ProgressBar x:Name="LeftMeter" Height="18" Maximum="1" Foreground="{StaticResource Cyan}" MaxWidth="420" HorizontalAlignment="Center" Width="420" MinWidth="300" Visibility="Visible" /></StackPanel></StackPanel>
     <StackPanel Grid.Column="1" Margin="8,0,0,0"><StackPanel Tag="SonicForgeMeterUnit" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Rechts" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" /><ProgressBar x:Name="RightMeter" Height="18" Maximum="1" Foreground="{StaticResource Pink}" MaxWidth="420" HorizontalAlignment="Center" Width="420" MinWidth="300" Visibility="Visible" /></StackPanel></StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="ClipText" Text="Pegel bereit" HorizontalAlignment="Center" Foreground="#59F2B5" FontWeight="SemiBold" />
    <StackPanel Grid.Row="3" VerticalAlignment="Bottom"><TextBlock Text="Ausgabeordner" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderBox" IsReadOnly="True" /><Button Grid.Column="1" Content="Ordner wählen" Click="ChooseFolder_Click" ToolTip="Waehlt den Ordner, in dem neue Aufnahmen gespeichert werden." /></Grid><TextBlock x:Name="TargetText" Foreground="#8FB6C8" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
   </Grid>
  </Border>
  <DockPanel Grid.Row="3">
   <Grid x:Name="QualityAndActionsPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel x:Name="CompactBottomPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="1120" Margin="0,8,0,10"><Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MetadataPanel" Margin="0,0,0,8" Padding="12" Background="#14263A" BorderBrush="#36536D" BorderThickness="1" CornerRadius="8" MaxWidth="1120" HorizontalAlignment="Center" Width="1120">
 <StackPanel>
  <TextBlock Text="Dateiname und Metadaten" FontSize="16" FontWeight="SemiBold" Foreground="#F3F7FA" Margin="0,0,0,8" />
  <Grid HorizontalAlignment="Stretch">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <TextBlock Grid.Row="0" Grid.Column="0" Text="Dateiname (optional)" Foreground="#C8D7E3" Grid.ColumnSpan="5" VerticalAlignment="Bottom" Margin="0,0,0,5" /><TextBox x:Name="CustomFileNameBox" Grid.Row="1" Grid.Column="0" Height="34" ToolTip="Ohne Dateiendung. Leer verwendet den automatischen SonicForge-Dateinamen." MinWidth="0" Grid.ColumnSpan="5" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,0" Padding="9,4,9,4" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
   <TextBlock Grid.Row="3" Grid.Column="0" Text="Titel" Foreground="#C8D7E3" Grid.ColumnSpan="1" VerticalAlignment="Bottom" Margin="0,0,0,5" /><TextBox x:Name="TitleMetadataBox" Grid.Row="4" Grid.Column="0" Height="34" HorizontalAlignment="Stretch" Grid.ColumnSpan="1" VerticalAlignment="Top" Margin="0,0,0,10" Padding="9,4,9,4" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
   <TextBlock Grid.Row="3" Grid.Column="2" Text="Interpret" Foreground="#C8D7E3" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,0,0,5" /><TextBox x:Name="ArtistMetadataBox" Grid.Row="4" Grid.Column="2" Height="34" HorizontalAlignment="Stretch" Grid.ColumnSpan="3" VerticalAlignment="Top" Margin="0,0,0,10" Padding="9,4,9,4" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
   <TextBlock Grid.Row="5" Grid.Column="0" Text="Album" Foreground="#C8D7E3" Grid.ColumnSpan="1" VerticalAlignment="Bottom" Margin="0,0,0,5" /><TextBox x:Name="AlbumMetadataBox" Grid.Row="6" Grid.Column="0" Height="34" HorizontalAlignment="Stretch" Grid.ColumnSpan="1" VerticalAlignment="Top" Margin="0,0,0,12" Padding="9,4,9,4" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
   <TextBlock Grid.Row="5" Grid.Column="2" Text="Jahr" Foreground="#C8D7E3" Grid.ColumnSpan="1" VerticalAlignment="Bottom" Margin="0,0,0,5" /><TextBox x:Name="YearMetadataBox" Grid.Row="6" Grid.Column="2" Height="34" MaxLength="4" HorizontalAlignment="Stretch" Grid.ColumnSpan="1" VerticalAlignment="Top" Margin="0,0,0,12" Padding="9,4,9,4" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
   <TextBlock Grid.Row="5" Grid.Column="4" Text="Genre" Foreground="#C8D7E3" Grid.ColumnSpan="1" VerticalAlignment="Bottom" Margin="0,0,0,5" /><TextBox x:Name="GenreMetadataBox" Grid.Row="6" Grid.Column="4" Height="34" HorizontalAlignment="Stretch" Grid.ColumnSpan="1" VerticalAlignment="Top" Margin="0,0,0,12" Padding="9,4,9,4" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
  <WrapPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,10">
 <Button x:Name="BuildFileNameButton" Content="Dateiname aus Interpret und Titel" Click="BuildFileNameButton_Click" Padding="13,6" Margin="0,0,8,0" />
 <Button x:Name="ClearMetadataButton" Content="Metadaten leeren" Click="ClearMetadataButton_Click" Padding="13,6" />
<CheckBox x:Name="KeepMetadataAfterRecordingCheckBox" Content="Metadaten und Cover nach Aufnahme behalten" IsChecked="True" VerticalAlignment="Center" Margin="18,0,0,0" ToolTip="Deaktivieren, um Dateiname, Metadaten und Cover nach erfolgreicher Aufnahme automatisch zu leeren." Foreground="#D9F7FF" /></WrapPanel></Grid>
 <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0,12,0,0" Padding="10" Background="#0C2232" BorderBrush="#31546B" BorderThickness="1" CornerRadius="6">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Width="86" Height="86" Background="#081923" BorderBrush="#42677F" BorderThickness="1"><Image x:Name="CoverPreviewImage" Stretch="UniformToFill" /></Border>
  <StackPanel Grid.Column="2" VerticalAlignment="Center">
   <TextBlock Text="Cover" FontWeight="SemiBold" Foreground="#F3F7FA" Margin="0,0,0,7" />
   <WrapPanel><Button Content="Im Internet suchen" Click="SearchCoverButton_Click" Padding="14,7" Margin="0,0,8,0" /><Button Content="Vom Computer" Click="SelectLocalCoverButton_Click" Padding="14,7" Margin="0,0,8,0" /><Button Content="Entfernen" Click="RemoveCoverButton_Click" Padding="14,7" /></WrapPanel>
   <TextBlock x:Name="CoverStatusText" Text="Kein Cover ausgewählt" Foreground="#B8CBD8" Margin="0,7,0,0" />
  </StackPanel>
 </Grid>
</Border></StackPanel>
</Border><Grid x:Name="QualityCompletionGrid" Margin="0,0,0,8" MaxWidth="1120" HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="QualityPanel" Margin="0" Padding="14" Background="#18283A" BorderBrush="#36536D" BorderThickness="1" CornerRadius="8" ToolTipService.ShowOnDisabled="True" MinWidth="520" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="0">
  <StackPanel>
    <TextBlock Text="Aufnahmequalität" FontSize="17" FontWeight="SemiBold" Foreground="#F3F7FA" Margin="0,0,0,10" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="Format" Foreground="#BFD0DF" Margin="0,0,0,4" /><ComboBox x:Name="FormatBox" SelectionChanged="QualitySelectionChanged" ToolTip="Legt fest, welche Dateien in einer späteren Phase erzeugt werden. Phase 6a ändert die WAV-Aufnahme noch nicht."><ComboBoxItem Content="WAV" /><ComboBoxItem Content="MP3" /><ComboBoxItem Content="WAV + MP3" /></ComboBox></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Qualitätsprofil" Foreground="#BFD0DF" Margin="0,0,0,4" /><ComboBox x:Name="QualityBox" SelectionChanged="QualitySelectionChanged" ToolTip="Standard: 192 kbit/s, Hoch: 256 kbit/s, Archiv: WAV 48 kHz/24 Bit und MP3 320 kbit/s."><ComboBoxItem Content="Standard" /><ComboBoxItem Content="Hoch" /><ComboBoxItem Content="Archiv" /></ComboBox></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Kanäle" Foreground="#BFD0DF" Margin="0,0,0,4" /><ComboBox x:Name="ChannelBox" SelectionChanged="QualitySelectionChanged" ToolTip="Quelle unverändert behält die Kanäle des Aufnahmegeräts. Mono und Stereo werden in Phase 6c umgesetzt."><ComboBoxItem Content="Quelle unverändert" /><ComboBoxItem Content="Mono" /><ComboBoxItem Content="Stereo" /></ComboBox></StackPanel>
    </Grid>
    <TextBlock x:Name="QualitySummaryText" Margin="0,10,0,0" Foreground="#83E6EF" TextWrapping="Wrap" Text="Die stabile Aufnahme erfolgt in Phase 6a weiterhin als WAV." />
    <TextBlock Margin="0,5,0,0" Foreground="#91A6B8" TextWrapping="Wrap" Text="Phase 6a: Auswahloberfläche. MP3-Erzeugung und Kanalumwandlung folgen in den nächsten Teilphasen." />
  </StackPanel>
</Border><Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="CompletionPanel" Margin="0" Padding="14" Background="#102D32" BorderBrush="#158A91" BorderThickness="1" CornerRadius="8" Visibility="Visible" Grid.Column="2" VerticalAlignment="Stretch" Loaded="CompletionPanel_Loaded">
  <StackPanel>
    <TextBlock Text="Aufnahme erfolgreich gespeichert" FontSize="17" FontWeight="SemiBold" Foreground="#8CF3E8" Margin="0,0,0,8" />
    <TextBlock x:Name="CompletionFileText" Text="Datei:" Foreground="#F3F7FA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="CompletionFormatText" Text="Format:" Foreground="#C8D7E3" Margin="0,4,0,0" />
    <TextBlock x:Name="CompletionProfileText" Text="Profil:" Foreground="#C8D7E3" Margin="0,4,0,0" />
    <TextBlock x:Name="CompletionAudioText" Text="Audio:" Foreground="#C8D7E3" Margin="0,4,0,0" />
    <TextBlock x:Name="CompletionSizeText" Text="Gr&amp;#xF6;&amp;#xDF;e:" Foreground="#C8D7E3" Margin="0,4,0,0" />
  </StackPanel>
</Border></Grid><TextBlock x:Name="StatusText" Text="Bereit" Foreground="#59F2B5" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,6" MaxWidth="1080" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="48" MinHeight="48" MaxHeight="48" VerticalAlignment="Center" Margin="0,0,0,4"><Button Content="Automatikmodus" Click="AutoMode_Click" Background="#0B7085" Foreground="White" ToolTip="Oeffnet die automatische Aufnahme mit Musikerkennung und Stilletrennung." /><Button x:Name="RecordButton" Content="Aufnahme" Background="#C82745" Click="Record_Click" ToolTip="Startet die Aufnahme mit der ausgewaehlten Audioquelle." Height="48" MinHeight="48" VerticalAlignment="Bottom" Padding="12,8" MaxHeight="48" MinWidth="84" HorizontalAlignment="Center" Margin="4,0" /><Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" IsEnabled="False" ToolTip="Unterbricht oder setzt die laufende Aufnahme fort." Height="48" MinHeight="48" VerticalAlignment="Bottom" Padding="12,8" MaxHeight="48" MinWidth="84" HorizontalAlignment="Center" Margin="4,0" /><Button x:Name="StopButton" Content="Stopp" Click="Stop_Click" IsEnabled="False" ToolTip="Beendet die Aufnahme und speichert die Audiodatei." Height="48" MinHeight="48" VerticalAlignment="Bottom" Padding="12,8" MaxHeight="48" MinWidth="84" HorizontalAlignment="Center" Margin="4,0" /><Button x:Name="CancelButton" Content="Verwerfen" Click="Cancel_Click" IsEnabled="False" ToolTip="Beendet die Aufnahme und verwirft die noch nicht gewollte Datei." Height="48" MinHeight="48" VerticalAlignment="Bottom" Padding="12,8" MaxHeight="48" MinWidth="84" HorizontalAlignment="Center" Margin="4,0" /><Border Width="1" Height="28" Margin="10,0,8,0" Background="#33566A" VerticalAlignment="Center" /><Button x:Name="PlaySavedButton" Content="Abspielen" Click="PlaySavedButton_Click" Height="48" MinWidth="118" Margin="0,0,8,0" Padding="14,0" IsEnabled="True" ToolTip="Ã–ffnet die zuletzt gespeicherte Aufnahme mit der Windows-Standardanwendung." /><Button x:Name="OpenSavedFolderButton" Content="Ordner oeffnen" Click="OpenSavedFolderButton_Click" Height="48" MinWidth="142" Padding="14,0" IsEnabled="True" ToolTip="Ã–ffnet den Aufnahmeordner und markiert die zuletzt gespeicherte Datei." /></StackPanel></StackPanel></Grid>
  </DockPanel>
 </Grid>
</Window>