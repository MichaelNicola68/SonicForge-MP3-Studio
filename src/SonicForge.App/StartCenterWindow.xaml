<Window x:Class="SonicForge.App.StartCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SonicForge Studiozentrale" Width="1040" Height="720" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#030C13" Foreground="White" FontFamily="Segoe UI">
<Window.Resources>
 <Style x:Key="CardButton" TargetType="Button"><Setter Property="Background" Value="#081C27"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1B4B5E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#0D3040"/><Setter TargetName="B" Property="BorderBrush" Value="#20DFF2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#0E5368"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#123244"/><Setter Property="BorderBrush" Value="#24586D"/><Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/></Style>
</Window.Resources>
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SONICFORGE" Foreground="#20DFF2" FontWeight="Bold" FontSize="13"/><TextBlock Text="Was möchtest du heute machen?" FontSize="31" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="CDs sichern, analoge Musik digitalisieren oder eigene Aufnahmen erstellen." Foreground="#91B8C8" FontSize="15" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Background="#0B2734" BorderBrush="#1D5267" BorderThickness="1" CornerRadius="14" Padding="15,10" VerticalAlignment="Center"><TextBlock Text="STUDIO BEREIT" Foreground="#73EFB8" FontWeight="Bold"/></Border></Grid>
 <TextBlock Grid.Row="1" Text="HAUPTBEREICHE" Foreground="#20DFF2" FontWeight="Bold" FontSize="12" Margin="0,24,0,10"/>
 <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Button Style="{StaticResource CardButton}" Click="Cd_Click" ToolTip="Oeffnet den CD-Import zum Einlesen und Speichern einer Audio-CD als MP3 oder WAV."><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="#12495D" VerticalAlignment="Top"><TextBlock Text="CD" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66EEFF"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Audio-CD zu MP3" FontSize="21" FontWeight="Bold"/><TextBlock Text="Titel einlesen, Metadaten und Cover ergänzen und als MP3 oder WAV sichern." Foreground="#A5C5D1" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="CD-IMPORT ÖFFNEN  ›" Foreground="#20DFF2" FontWeight="Bold" Margin="0,18,0,0"/></StackPanel></Grid></Button>
  <Button Grid.Column="2" Style="{StaticResource CardButton}" Click="Analog_Click" ToolTip="Oeffnet das Aufnahmestudio fuer Schallplatten und Kassetten mit bevorzugtem externen Eingang."><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="#493B6A" VerticalAlignment="Top"><TextBlock Text="VINYL" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D7C2FF"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Schallplatte oder Kassette" FontSize="21" FontWeight="Bold"/><TextBlock Text="Line-In auswählen, Pegel prüfen und analoge Musik sauber digitalisieren." Foreground="#A5C5D1" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="AUFNAHMESTUDIO ÖFFNEN  ›" Foreground="#C9AFFF" FontWeight="Bold" Margin="0,18,0,0"/></StackPanel></Grid></Button>
  <Button Grid.Row="2" Style="{StaticResource CardButton}" Click="Streaming_Click" ToolTip="Oeffnet das Aufnahmestudio fuer Systemton und Streamingquellen."><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="#174C3B" VerticalAlignment="Top"><TextBlock Text="LIVE" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7AF0B7"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Streamingaufnahme" FontSize="21" FontWeight="Bold"/><TextBlock Text="Systemton aufnehmen und mit der automatischen Musikerkennung in Titel aufteilen." Foreground="#A5C5D1" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="SYSTEMTON-AUFNAHME  ›" Foreground="#73EFB8" FontWeight="Bold" Margin="0,18,0,0"/></StackPanel></Grid></Button>
  <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CardButton}" Click="Musician_Click" ToolTip="Oeffnet das Aufnahmestudio fuer Mikrofon, Gitarre, Keyboard oder Audiointerface."><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="#673144" VerticalAlignment="Top"><TextBlock Text="REC" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFACC3"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Mikrofon oder Instrument" FontSize="21" FontWeight="Bold"/><TextBlock Text="Gesang, Gitarre, Keyboard oder andere Quellen über Mikrofon und Audiointerface aufnehmen." Foreground="#A5C5D1" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="MUSIKAUFNAHME STARTEN  ›" Foreground="#FF9DB8" FontWeight="Bold" Margin="0,18,0,0"/></StackPanel></Grid></Button>
 </Grid>
 <Border Grid.Row="3" Background="#071923" BorderBrush="#173D4D" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Weitere Bereiche" FontWeight="Bold"/><TextBlock Text="Bibliothek und Internetradio bleiben als ergänzende Werkzeuge erreichbar." Foreground="#8DB2C2" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,6,0"><Button Content="Bibliothek" Click="Library_Click" Margin="0,0,6,0" ToolTip="Schliesst die Studiozentrale und zeigt die lokale SonicForge-Musikbibliothek."/><Button Content="Wunschliste" Click="Wishlist_Click" Margin="6,0" ToolTip="Oeffnet die lokale Wunschliste fuer gesuchte Titel und Alben."/><Button Content="Spotify öffnen" Click="Spotify_Click" Margin="6,0" ToolTip="Startet bevorzugt die installierte Spotify-App, sonst den Webplayer."/></StackPanel><Button Grid.Column="2" Content="Radio &amp; Podcasts" Click="Radio_Click" Margin="6,0,0,0" ToolTip="Oeffnet das Zusatzmodul fuer Internetradio und Podcasts."/></Grid></Border>
</Grid></Window>
