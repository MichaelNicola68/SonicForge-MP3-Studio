<Window x:Class="SonicForge.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SonicForge Einstellungen" Width="860" Height="720" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#061018" Foreground="White">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#102633"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#245064"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#F2F5F7"/><Setter Property="Foreground" Value="#071219"/><Setter Property="BorderBrush" Value="#18E5FF"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,5,0,12"/></Style><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#F2F5F7"/><Setter Property="Foreground" Value="#071219"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#18E5FF"/><Setter Property="Foreground" Value="#031016"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0E8FA7"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="5"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0A1B25"/><Setter Property="BorderBrush" Value="#245064"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,15"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="EINSTELLUNGEN" Foreground="#18E5FF" FontWeight="Bold"/><TextBlock Text="SonicForge zentral konfigurieren" FontSize="28" FontWeight="Bold" Margin="0,5,0,4"/><TextBlock Text="Aufnahme, Automatik, Metadaten und Dateinamen" Foreground="#8FB6C8" Margin="0,0,0,18"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Aufnahme" FontSize="20" FontWeight="Bold" Foreground="#18E5FF"/>
    <TextBlock Text="Standard-Aufnahmeordner" Margin="0,12,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderBox"/><Button Grid.Column="1" Content="Auswählen" Click="ChooseFolder_Click" VerticalAlignment="Top"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="Startschwelle (dB)"/><TextBox x:Name="StartDbBox"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Stoppschwelle (dB)"/><TextBox x:Name="StopDbBox"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Stille bis Stopp (Sek.)"/><TextBox x:Name="SilenceBox"/></StackPanel>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="Musikstart bestätigen (Sek.)"/><TextBox x:Name="ConfirmBox"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Vorlauf (Sek.)"/><TextBox x:Name="PreRollBox"/></StackPanel>
    </Grid><CheckBox x:Name="AutoThresholdCheck" Content="Start- und Stoppschwelle automatisch kalibrieren"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Metadaten und Cover" FontSize="20" FontWeight="Bold" Foreground="#FF4FD8"/>
    <TextBlock Text="Bevorzugte Metadatenquelle" Margin="0,12,0,0"/><ComboBox x:Name="MetadataSourceBox"><ComboBoxItem Content="Automatisch"/><ComboBoxItem Content="Windows-Medieninformationen"/><ComboBoxItem Content="Deezer"/><ComboBoxItem Content="MusicBrainz"/></ComboBox>
    <CheckBox x:Name="AutoMetadataCheck" Content="Titel, Interpret, Album, Genre und Jahr automatisch ermitteln"/><CheckBox x:Name="AutoCoverCheck" Content="Albumcover automatisch suchen und einbetten"/><CheckBox x:Name="OpenEditorCheck" Content="Tag- und Cover-Editor nach der Aufnahme öffnen"/>
    <TextBlock Text="Spotify wird in der nächsten Ausbaustufe als zusätzliche Quelle ergänzt." Foreground="#D7A83B" Margin="0,9,0,0" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dateinamen" FontSize="20" FontWeight="Bold" Foreground="#59F2B5"/><TextBlock Text="Schema für automatisch erkannte Titel" Margin="0,12,0,0"/><TextBox x:Name="PatternBox"/><TextBlock Text="Verfügbare Platzhalter: {Interpret}, {Titel}, {Album}, {Jahr}" Foreground="#8FB6C8"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Foreground="#59F2B5" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Standardwerte" Click="Reset_Click"/><Button Content="Abbrechen" Click="Cancel_Click"/><Button Content="Speichern" Click="Save_Click" Background="#18E5FF" Foreground="#041018" FontWeight="Bold"/></StackPanel></DockPanel>
 </Grid>
</Window>
